; Supervisor configuration for OpenRVDAS data simulator - generated by Ansible
; Do not edit by hand; re-run the Ansible playbook to regenerate.

{% if install_simulate_nbp %}
[program:simulate_nbp]
command={{ install_root }}/openrvdas/venv/bin/python logger/utils/simulate_data.py --config test/NBP1406/simulate_NBP1406.yaml
directory={{ install_root }}/openrvdas
autostart={{ run_simulate_nbp | lower }}
autorestart=true
startretries=3
killasgroup=true
stderr_logfile=/var/log/openrvdas/simulate_nbp.stderr
stderr_logfile_maxbytes=10000000
stderr_logfile_maxbackups=100
user={{ rvdas_user }}

[group:simulate]
programs=simulate_nbp
{% endif %}
