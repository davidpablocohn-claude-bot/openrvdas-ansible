; Supervisor configuration for React UI (nginx + uvicorn) - generated by Ansible
; Do not edit by hand; re-run the Ansible playbook to regenerate.

{% if install_gui %}
[program:nginx]
command={{ nginx_bin }} -g 'daemon off;' -c {{ install_root }}/openrvdas/web_frontend/openrvdas_nginx.conf
directory={{ install_root }}/openrvdas
autostart={{ openrvdas_autostart | lower }}
autorestart=true
startretries=3
killasgroup=true
stderr_logfile=/var/log/openrvdas/nginx.stderr
stderr_logfile_maxbytes=10000000
stderr_logfile_maxbackups=100

[program:uvicorn]
command={{ install_root }}/openrvdas/web_backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
directory={{ install_root }}/openrvdas/web_backend
autostart={{ openrvdas_autostart | lower }}
autorestart=true
startretries=3
killasgroup=true
stderr_logfile=/var/log/openrvdas/uvicorn.stderr
stderr_logfile_maxbytes=10000000
stderr_logfile_maxbackups=100
user={{ rvdas_user }}

[group:react_ui]
programs=nginx,uvicorn
{% endif %}
