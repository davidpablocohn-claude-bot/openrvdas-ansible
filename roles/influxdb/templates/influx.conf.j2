; Supervisor configuration for InfluxDB services
; Managed by Ansible — do not edit by hand

; ── InfluxDB ──────────────────────────────────────────────────────────────────
[program:influxdb]
command={{ influxdb_bin }}
  --bolt-path {{ influxdb_engine_path }}/influxd.bolt
  --engine-path {{ influxdb_engine_path }}/engine
{% if ansible_os_family != "Darwin" %}
user={{ influxdb_user }}
{% endif %}
autostart=true
autorestart=true
startretries=3
stdout_logfile={{ influx_log_dir }}/influxdb.stdout
stderr_logfile={{ influx_log_dir }}/influxdb.stderr
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB

{% if install_grafana %}
; ── Grafana ───────────────────────────────────────────────────────────────────
[program:grafana]
command={{ grafana_bin }}
{% if ansible_os_family != "Darwin" %}
  --homepath {{ grafana_home }}
  --config {{ grafana_conf }}
{% endif %}
{% if ansible_os_family != "Darwin" %}
user={{ grafana_user }}
{% endif %}
; The Debian/RPM grafana packages ship grafana.ini with paths.data commented out
; and rely on systemd to supply GF_PATHS_*. Under supervisor nothing sets them,
; so grafana resolves paths.data relative to --homepath (/usr/share/grafana/data,
; root-owned) and dies with "permission denied" creating grafana.db. Point it at
; the directories roles/grafana/tasks/configure.yml creates. GF_PATHS_PROVISIONING
; is deliberately NOT set: the InfluxDB datasource is provisioned into
; {{ '{{ grafana_home }}' }}/conf/provisioning, which is where grafana already looks.
environment=GF_SECURITY_ADMIN_PASSWORD="{{ grafana_password }}",GF_PATHS_DATA="{{ grafana_data }}",GF_PATHS_LOGS="{{ grafana_log }}",GF_PATHS_PLUGINS="{{ grafana_plugins }}"
autostart=true
autorestart=true
startretries=3
stdout_logfile={{ influx_log_dir }}/grafana.stdout
stderr_logfile={{ influx_log_dir }}/grafana.stderr
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
{% endif %}

{% if install_telegraf %}
; ── Telegraf ──────────────────────────────────────────────────────────────────
[program:telegraf]
command={{ telegraf_bin }} --config {{ telegraf_conf }}
{% if ansible_os_family != "Darwin" %}
user={{ telegraf_user }}
{% endif %}
autostart=true
autorestart=true
startretries=3
stdout_logfile={{ influx_log_dir }}/telegraf.stdout
stderr_logfile={{ influx_log_dir }}/telegraf.stderr
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
{% endif %}

; ── Group ─────────────────────────────────────────────────────────────────────
[group:influx]
programs=influxdb{% if install_grafana %},grafana{% endif %}{% if install_telegraf %},telegraf{% endif %}
