module grafana-influx 1.0;

require {
    type grafana_t;
    type unreserved_port_t;
    type dns_port_t;
    class tcp_socket name_connect;
}

#============= grafana_t ==============
# Allow the confined Grafana service (grafana_t) to make outbound TCP
# connections to InfluxDB (default 8086, labelled unreserved_port_t) and to
# perform TCP DNS resolution. Without this, SELinux blocks Grafana from using
# InfluxDB as a datasource on RedHat-family hosts with SELinux enforcing.
allow grafana_t dns_port_t:tcp_socket name_connect;
allow grafana_t unreserved_port_t:tcp_socket name_connect;
