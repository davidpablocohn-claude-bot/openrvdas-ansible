# openrvdas_nginx_react.conf - generated by Ansible
# Do not edit by hand; re-run the Ansible playbook to regenerate.

worker_processes  auto;
events {
    worker_connections  1024;
}

http {
    types {
        text/html                   html htm;
        text/css                    css;
        application/javascript      js mjs;
        application/json            json;
        image/svg+xml               svg svgz;
        image/png                   png;
        image/jpeg                  jpeg jpg;
        image/x-icon                ico;
        font/woff2                  woff2;
        font/woff                   woff;
        font/ttf                    ttf;
    }
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

{% if use_ssl %}
    # HTTP → HTTPS redirect
    server {
        listen *:{{ nonssl_server_port }} default_server;
        server_name _;
        return 301 https://$host:{{ ssl_server_port }}$request_uri;
    }

{% endif %}
    server {
        listen *:{{ server_port }}{% if use_ssl %} ssl{% endif %} default_server;
        server_name _;
        charset utf-8;

{% if use_ssl %}
        ssl_certificate     {{ ssl_crt_location }};
        ssl_certificate_key {{ ssl_key_location }};
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

{% endif %}
        root {{ install_root }}/openrvdas/web_frontend/dist;
        index index.html;

        # FastAPI REST API
        location /api/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI WebSocket endpoint
        location /ws/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
        }

        # Proxy Cached Data Server WebSocket (internal :{{ openrvdas_data_port }} → external /cds-ws)
        location /cds-ws {
            proxy_pass http://localhost:{{ openrvdas_data_port }};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
        }

        # React SPA — fall through to index.html for client-side routing
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
