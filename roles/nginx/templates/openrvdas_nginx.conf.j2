# openrvdas_nginx.conf - generated by Ansible
# Do not edit by hand; re-run the Ansible playbook to regenerate.

worker_processes  auto;
events {
    worker_connections  1024;
}

http {
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # uWSGI upstream socket
    upstream django {
        server unix:///{{ install_root }}/openrvdas/django_gui/openrvdas.sock;
    }

{% if use_ssl %}
    # HTTP → HTTPS redirect
    server {
        listen *:{{ nonssl_server_port }} default_server;
        server_name _;
        return 301 https://$host:{{ ssl_server_port }}$request_uri;
    }

{% endif %}
    server {
        listen *:{{ server_port }}{% if use_ssl %} ssl{% endif %} default_server;
        server_name _;
        charset utf-8;

{% if use_ssl %}
        ssl_certificate     {{ ssl_crt_location }};
        ssl_certificate_key {{ ssl_key_location }};
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

{% endif %}
        client_max_body_size 75M;

        location /media {
            alias {{ install_root }}/openrvdas/media;
        }

        location /display {
            alias {{ install_root }}/openrvdas/display/html;
            autoindex on;
        }

        location /js {
            alias {{ install_root }}/openrvdas/display/js;
            default_type application/javascript;
        }

        location /css {
            alias {{ install_root }}/openrvdas/display/css;
            default_type text/css;
        }

        location /static {
            alias {{ install_root }}/openrvdas/django_gui/static;
            types { text/css css; text/javascript js; }
            autoindex on;
        }

        location /docs {
            alias {{ install_root }}/openrvdas/docs;
            autoindex on;
        }

        # Proxy Cached Data Server WebSocket (internal :8766 → external /cds-ws)
        location /cds-ws {
            proxy_pass http://localhost:8766;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
        }

        # All other requests go to Django via uWSGI
        location / {
            uwsgi_pass  django;
            include     {{ install_root }}/openrvdas/django_gui/uwsgi_params;
        }
    }
}
