# openrvdas_uwsgi.ini - generated by Ansible
# Do not edit by hand; re-run the Ansible playbook to regenerate.

[uwsgi]

# Django-related settings
chdir           = {{ install_root }}/openrvdas
module          = django_gui.wsgi
home            = {{ install_root }}/openrvdas/venv

# process-related settings
master          = true
processes       = 10
socket          = {{ install_root }}/openrvdas/django_gui/openrvdas.sock
chmod-socket    = 666
vacuum          = true
