---
# OpenRVDAS secret variables
#
# Copy this file to vault/secrets.yml and populate with real values, then encrypt:
#   cp vault/secrets.yml.example vault/secrets.yml
#   ansible-vault encrypt vault/secrets.yml
#
# Run the playbook with:
#   ansible-playbook site.yml -i inventory/hosts.ini --ask-vault-pass
#
# Or with a vault password file:
#   ansible-playbook site.yml -i inventory/hosts.ini --vault-password-file ~/.vault_pass

# Password for the Django superuser and database operations
rvdas_database_password: changeme

# Password for the supervisord web interface (used when supervisord_webinterface_auth: true)
supervisord_webinterface_pass: changeme

# ── InfluxDB / Grafana secrets ────────────────────────────────────────────────
# InfluxDB admin password
influxdb_password: changeme

# InfluxDB API token (used by OpenRVDAS, Telegraf, and Grafana to write/read data)
# Generate a strong random string, e.g.: openssl rand -hex 32
influxdb_token: changeme-replace-with-a-long-random-token

# Grafana admin password
grafana_password: changeme
